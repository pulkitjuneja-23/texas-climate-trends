{
  "name": "texas-climate-trends",
  "version": "0.1.0",
  "private": true,
  "description": "Farmer-facing historical climate trends for Texas — 30-year normals, individual years, forecast, and analog-year matching.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "archive:refresh": "node --experimental-strip-types scripts/ingest-gridmet.mts --r2 --part current",
    "archive:rebuild": "node --experimental-strip-types scripts/ingest-gridmet.mts --r2"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@google/earthengine": "^1.7.40",
    "@vercel/analytics": "^2.0.1",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  }
}
